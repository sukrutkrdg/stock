# The public origin the Mini App manifest is signed against. Must match exactly
# — a mismatch makes the account association invalid and Base App will not list
# the app. Leave unset locally to fall back to http://localhost:3000.
NEXT_PUBLIC_URL=https://your-domain.vercel.app

# Account association from https://base.dev — paste your domain, sign with the
# publishing wallet, then copy the three fields it produces.
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=

# Swap routing needs no key: Slate routes through the KyberSwap aggregator,
# which is one of the venues Coinbase lists as live for tokenized stocks.
# The 0x Swap API is NOT usable here — it answers any `*c` equity token with
# 422 BUY_TOKEN_NOT_AUTHORIZED_FOR_TRADE, a compliance gate on their side.

# Neon Postgres, injected automatically by `vercel integration add neon`.
DATABASE_URL=

# Builder Code from base.dev (Settings -> Builder Code). Appended to every
# transaction as an ERC-8021 suffix so Base attributes the activity to this app.
# Public by design: it travels in calldata on every transaction.
NEXT_PUBLIC_BUILDER_CODE=

# Optional: a dedicated Base RPC. Without it the app uses the public endpoint,
# which is fine for development and rate-limited under real traffic.
BASE_RPC_URL=

# Set by Vercel for cron invocations; the DCA reminder route rejects anything
# that does not present it.
CRON_SECRET=
